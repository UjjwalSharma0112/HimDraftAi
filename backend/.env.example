# ==========================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==========================================

# Environment Mode (production / development)
NODE_ENV=production

# Port the backend server will run on (Default: 8080 or Render PORT)
PORT=8080

# Production Frontend URL (used for CORS policy & Google OAuth redirects)
CLIENT_URL=https://your-frontend-app.vercel.app

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/himdraftai?retryWrites=true&w=majority

# Secret key used to sign and verify JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-app.onrender.com/api/auth/google/callback

# Google Gemini API Key for AI product copy generation
GEMINI_API_KEY=your_gemini_api_key_here
